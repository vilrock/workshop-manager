{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Postgres": {
    "CommandTimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "workshop-manager",
    "Audience": "workshop-manager-clients",
    "ExpiresMinutes": 60
  },
  "RateLimiting": {
    "LoginPermitLimit": 10
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "AllowedHosts": "*"
}
